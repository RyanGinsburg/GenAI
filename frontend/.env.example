# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Vite only exposes env vars prefixed VITE_ to client-side code, and this
# one is safe to expose - it's a public OAuth client ID, not a secret (the
# actual secret, GOOGLE_CLIENT_SECRET, stays backend-only and unused by
# this Sign-In flow anyway).

# Must match the backend's GOOGLE_CLIENT_ID (see the repo root .env) - kept
# in sync manually, there's no automated sharing between the two .env
# files.
VITE_GOOGLE_CLIENT_ID=
