# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it, and never hardcode these values in source.
#
#   cp .env.example .env

# Anthropic API key, for resume parsing and club-site research.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Firecrawl API key, for crawling club websites in research_agent.py
# (replaces the old headless-browser fetch — see CLAUDE.md's dated entry).
# Get one at: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Secret used to sign account login tokens (JWTs). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Any value works for local dev, but keep it out of git and don't reuse
# a real one across environments.
JWT_SECRET_KEY=

# Google OAuth2 client. Used now for "Sign in with Google" (the frontend's
# Google Identity Services button verifies against GOOGLE_CLIENT_ID only —
# the secret isn't needed for that), and earmarked for later use adding
# approved events to Google Calendar (Step 7, still unbuilt).
#
# IMPORTANT: this must be an OAuth 2.0 Client ID of type "Web application"
# (Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth
# client ID -> Web application), with http://localhost:3000 added under
# "Authorized JavaScript origins". A "Desktop app" client (what an earlier
# version of this file described, for the Calendar step) will NOT work for
# Sign-In — convert/replace the client if it was created that way. The same
# Web application client can still serve Calendar's OAuth later (just add a
# redirect URI to it when that step is built).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP credentials for sending password-reset emails (stdlib smtplib, no
# extra dependency). Any standard SMTP provider works, e.g. a Gmail App
# Password (myaccount.google.com/apppasswords) or a transactional-email
# provider's SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Base URL of the running frontend, used to build password-reset links
# (e.g. http://localhost:3000/?resetToken=<token>). Change for a real
# deployment.
FRONTEND_BASE_URL=http://localhost:3000
