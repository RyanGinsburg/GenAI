# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it, and never hardcode these values in source.
#
#   cp .env.example .env

# Anthropic API key, for resume parsing and club-site research.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Secret used to sign account login tokens (JWTs). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Any value works for local dev, but keep it out of git and don't reuse
# a real one across environments.
JWT_SECRET_KEY=

# Google OAuth2 client, for adding approved events to Google Calendar.
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# (Desktop app). Enable the Google Calendar API on the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
